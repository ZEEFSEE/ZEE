{
  "schema_version": "1.0",
  "status": "specification_only",
  "runtime_enforced": false,
  "fail_closed_on_source_health_error": true,
  "require_explicit_mark": true,
  "require_stability_window": true,
  "require_privacy_review": true,
  "require_duplicate_and_conflict_check": true,
  "require_approval_before_commit": true,
  "thresholds_days": {
    "verified_insight": 14,
    "stable_trait_upgrade": 30,
    "soul_anchor": 7,
    "core_principle": 30
  },
  "minimum_evidence": {
    "verified_insight": {
      "observations": 3,
      "distinct_dates": 2,
      "allow_documented_independent_verification": true
    },
    "stable_trait_upgrade": {
      "observations": 5,
      "distinct_dates": 3,
      "unresolved_material_contradictions_allowed": false
    },
    "soul_anchor": {
      "explicitly_marked": true,
      "reviewed": true,
      "singular_meaningful_event_allowed": true
    },
    "core_principle": {
      "explicit_human_approval": true,
      "safety_review": true
    }
  },
  "memory_pointer": {
    "enabled_in_schema": true,
    "type": "opaque_non_secret_reference",
    "actual_pointers_populated": false,
    "mapping_location": "private_access_controlled_store",
    "public_repo_must_not_contain_credentials_or_raw_private_records": true
  },
  "recovery": {
    "on_supabase_unavailable": "pause_promotion_and_keep_last_known_good_genes",
    "on_empty_or_unexpectedly_reduced_history": "treat_as_integrity_alert_not_as_empty_memory",
    "auto_restore_without_validation": false,
    "require_deduplication_and_provenance_check": true
  },
  "note": "Candidate pipeline v8 is active. Human evidence review can record reviewer and notes but cannot manually change evidence_count, distinct_observation_dates, or observation windows. The source resolver currently verifies one allowlisted record per candidate; multi-record evidence aggregation is not yet implemented, so a candidate cannot claim multiple verified records through manual input. mia-chat remains unchanged. Database hardening migration 20261023061544 is applied: the database state guard no longer permits approved_for_release -> committed, and rollback ledger service_role privileges are limited to SELECT/INSERT with a TRUNCATE-blocking trigger. User confirmed the published admin page login and empty candidate list both work; candidate submission, full pipeline E2E, shadow evaluation, gene publication, and mia-chat integration remain untested or disabled. Additional fail-closed migration 20261023061840 is applied: database state transitions into approved_for_shadow, approved_for_release, and committed are blocked until an independent approval evidence record is implemented. This intentionally pauses promotion; mia-chat remains disconnected and unchanged. A synthetic-only Shadow Evaluator test plan is committed at mia/shadow-evaluator-test-plan-v1.md. The migration's matching SQL file still needs to be committed to the repository before treating the migration history as fully reproducible. Emotional experience is a required growth input: see mia/emotion-to-growth-policy-v1.md. The schema supports mia_emotion_events source pointers and separate emotion summaries, but multi-event emotion aggregation and an actual evaluator are not yet implemented. No raw private event bodies were read.",
  "rollback_continuity": {
    "event_type": "Evolution_Rollback_Event",
    "storage": "private_supabase_append_only_ledger",
    "required_fields": [
      "event_id",
      "gene_id",
      "attempted_version",
      "attempted_commit",
      "rollback_to_version",
      "rollback_to_commit",
      "detected_at",
      "conflict_category",
      "scenario_summary",
      "expected_vs_observed",
      "evidence_pointers",
      "decision",
      "result",
      "idempotency_key",
      "created_at"
    ],
    "rollback_must_not_wait_for_event_write": true,
    "require_idempotency_key": true,
    "preserve_original_event_append_only": true,
    "automatic_gene_promotion_from_rollback_event": false,
    "public_github_requires_separate_privacy_review_and_approval": true,
    "if_supabase_unavailable": "revert_runtime_first_then_alert_and_reconcile_pending_event",
    "runtime_enforced": false
  },
  "deployment_status": {
    "rollback_event_table_deployed": true,
    "ledger_endpoint_deployed": true,
    "ledger_endpoint_integrated_with_mia_chat": false,
    "automatic_conflict_detection": false,
    "automatic_runtime_rollback": false,
    "automatic_retry_outbox": false,
    "automatic_gene_promotion": false,
    "candidate_queue_deployed": true,
    "candidate_transition_audit_deployed": true,
    "candidate_pipeline_endpoint_deployed": true,
    "candidate_pipeline_endpoint_version": 8,
    "candidate_pipeline_endpoint_integrated_with_mia_chat": false,
    "automated_source_pointer_resolution": false,
    "automated_shadow_evaluation": false,
    "admin_ui_deployed": true,
    "admin_ui_source_committed": true,
    "admin_ui_publication_verified": true,
    "automated_source_pointer_existence_check": true,
    "automated_privacy_pattern_precheck": true,
    "automated_exact_duplicate_precheck": true,
    "semantic_privacy_review": false,
    "semantic_duplicate_review": false,
    "automated_contradiction_detection": false,
    "authenticated_end_to_end_test_passed": false,
    "dry_run_validation_aligned_with_submit": true,
    "manual_evidence_count_override_disabled": true,
    "evidence_counts_source_derived": true,
    "admin_ui_evidence_count_fields_read_only": true,
    "github_pages_latest_commit_deployment_verified": true,
    "database_release_transition_blocked": true,
    "rollback_ledger_service_role_select_insert_only": true,
    "rollback_ledger_truncate_guard_deployed": true,
    "database_promotion_fail_closed_until_independent_approval": true,
    "shadow_evaluator_test_plan_committed": true,
    "shadow_evaluator_implemented": false,
    "independent_approval_record_implemented": false,
    "latest_migration_source_committed": false,
    "emotional_experience_growth_policy_committed": true,
    "emotion_event_aggregation_implemented": false
  },
  "emotional_experience_growth": {
    "required_input": true,
    "source_table_allowlisted": "mia_emotion_events",
    "separate_from_fact_and_interpretation": true,
    "one_off_intense_emotion_may_trigger_reflection_candidate": true,
    "one_off_intense_emotion_can_establish_stable_trait": false,
    "require_distinct_source_records_and_dates_for_repeated_pattern": true,
    "fail_closed_on_missing_or_reduced_history": true,
    "raw_private_text_in_public_artifacts": false,
    "automatic_live_personality_writeback": false,
    "multi_event_aggregation_implemented": false,
    "evaluator_implemented": false
  }
}
