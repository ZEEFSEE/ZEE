{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhi.example/schemas/zpcl-seed-1.0.schema.json",
  "title": "ZPCL Cognitive Seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed_id", "agent_id", "created_at", "status", "stage", "observation", "hypothesis", "verification", "version"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "seed_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["candidate", "observing", "hypothesized", "verified", "stable", "rejected", "archived"]},
    "stage": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5"]},
    "observation": {
      "type": "object",
      "required": ["content", "source_event_ids"],
      "properties": {
        "content": {"type": "string"},
        "source_event_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hypothesis": {
      "type": "object",
      "required": ["content", "confidence"],
      "properties": {
        "content": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "verification": {"type": "object"},
    "version": {"type": "integer", "minimum": 1}
  }
}
