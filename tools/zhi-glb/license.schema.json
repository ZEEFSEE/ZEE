{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZHI License v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "license_id",
    "asset_id",
    "version",
    "licensee_id",
    "issued_at",
    "not_before",
    "expires_at",
    "scope",
    "status"
  ],
  "properties": {
    "protocol": {
      "const": "ZHI-LICENSE-1.0"
    },
    "license_id": {
      "type": "string",
      "minLength": 8
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$"
    },
    "licensee_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "revoked"
      ]
    }
  }
}
