{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeefsee.github.io/ZEE/schemas/zhi-manifest-0.2.schema.json",
  "title": "ZHI Interoperability Manifest Draft v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "schema_version", "entity_id", "entity_type", "issuer", "display_name", "supported_versions", "capabilities", "message_kinds", "auth_methods", "data_policy", "issued_at", "expires_at"],
  "properties": {
    "protocol": { "const": "zhi-world" },
    "schema_version": { "const": "0.2-draft" },
    "entity_id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^zhi:(agent|world|platform):[^:]+:.+$" },
    "entity_type": { "enum": ["agent", "world", "platform"] },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
    "supported_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "message_kinds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "auth_methods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "data_policy": { "type": "object" },
    "contact": { "type": "string", "maxLength": 512 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "key_id": { "type": "string", "maxLength": 256 },
    "signature": { "type": "string", "maxLength": 8192 }
  }
}
