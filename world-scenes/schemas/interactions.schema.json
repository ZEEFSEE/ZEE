{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeefsee.github.io/ZEE/world-scenes/schemas/interactions.schema.json",
  "title": "ZHI Scene Interaction Contract",
  "type": "object",
  "required": ["schema_version", "interaction_id", "target_ref", "action"],
  "properties": {
    "schema_version": {"type": "string"},
    "interaction_id": {"type": "string", "minLength": 1},
    "target_ref": {"type": ["string", "null"]},
    "action": {"type": "string", "minLength": 1},
    "permission_contract": {"type": ["string", "null"]},
    "verification_status": {"enum": ["verified", "unverified", "pending"]}
  },
  "additionalProperties": true
}