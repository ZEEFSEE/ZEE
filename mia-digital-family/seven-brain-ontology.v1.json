    "family_memory_rule": "SHARED_SOURCE_REQUIRED",
    "missing_permission": "DENY",
    "missing_evidence": "MARK_UNKNOWN_OR_DERIVED",
    "rollback_policy": "REVERT_DERIVED_STATE_KEEP_RAW_EVENTS_AND_AUDIT"
