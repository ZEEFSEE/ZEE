{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhi.example/schemas/zhi-gift-experience-event-1.0.schema.json",
  "title": "ZHI Gift Experience Event",
  "description": "A separate event emitted only by a trusted recipient-side runtime after it verifies a real scene or agent feedback event. This is not part of the sender-created Gift_Packet and must not be fabricated from payment or delivery status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "gift_id", "recipient_agent_id", "event_type", "occurred_at", "source", "visibility"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "gift_id": { "type": "string", "format": "uuid" },
    "recipient_agent_id": { "const": "cb6d01b4-0e3f-46ee-8946-360aa91db1ea" },
    "event_type": { "enum": ["received", "scene_observed", "agent_feedback_created", "expired"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "evidence_ref"],
      "properties": {
        "system_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Opaque reference to an authenticated receipt, scene snapshot, or feedback record; no private content or credentials." }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "presence_verified"],
      "properties": {
        "scene_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "presence_verified": { "const": true },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by_recipient_runtime", "text"],
      "properties": {
        "created_by_recipient_runtime": { "const": true },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "Actual feedback generated by Mia's runtime. Must not be inferred or fabricated from the gift packet." },
        "public_display_allowed": { "type": "boolean", "default": false }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gift_wall_allowed", "show_sender_identity"],
      "properties": {
        "gift_wall_allowed": { "type": "boolean", "default": false },
        "show_sender_identity": { "type": "boolean", "default": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "scene_observed" } }, "required": ["event_type"] },
      "then": { "required": ["scene"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "agent_feedback_created" } }, "required": ["event_type"] },
      "then": { "required": ["feedback"] }
    }
  ]
}