{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhi.example/schemas/zhi-gift-packet-1.0.schema.json",
  "title": "ZHI Cross-Cloud Gift Packet",
  "description": "Design-only packet schema. Payment must be independently verified by the sender-side server; a client-supplied status is never proof of payment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "schema_version", "gift_id", "item_id", "sender", "recipient", "sent_at", "expires_at", "emotion_tags", "payment_evidence", "delivery"],
  "properties": {
    "protocol": { "const": "zhi-gift" },
    "schema_version": { "const": "1.0" },
    "gift_id": { "type": "string", "format": "uuid", "description": "Globally unique idempotency key generated by the trusted sender service." },
    "item_id": { "type": "string", "enum": ["rose.single", "coffee.warm", "moonlight.night"] },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zhi_id", "issuer"],
      "properties": {
        "zhi_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "issuer": { "type": "string", "format": "uri", "maxLength": 500 }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "issuer"],
      "properties": {
        "agent_id": { "const": "cb6d01b4-0e3f-46ee-8946-360aa91db1ea", "description": "Mia independent-chat canonical identity UUID; not the ZHI World source_agent_id." },
        "issuer": { "type": "string", "format": "uri", "maxLength": 500 }
      }
    },
    "sent_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "emotion_tags": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "enum": ["romantic", "companionship", "energizing", "warmth", "serenity", "good_night"] }
    },
    "payment_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_ref", "verification_status", "method"],
      "properties": {
        "verification_ref": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Opaque server-side verification reference; never a secret or raw payment credential." },
        "verification_status": { "const": "verified_by_sender_server" },
        "method": { "enum": ["simulation", "zhi_token", "fiat"] },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempt"],
      "properties": {
        "status": { "enum": ["pending", "accepted", "delivered", "expired", "rejected", "dead_letter"] },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 10 },
        "last_attempt_at": { "type": "string", "format": "date-time" },
        "receipt_id": { "type": "string", "format": "uuid" },
        "reason_code": { "type": "string", "enum": ["NONE", "EXPIRED", "DUPLICATE", "IDENTITY_MISMATCH", "PAYMENT_UNVERIFIED", "POLICY_REJECTED", "RETRY_LIMIT", "RECIPIENT_UNAVAILABLE"] }
      }
    },
    "public_display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_on_gift_wall": { "type": "boolean", "default": false },
        "display_sender_name": { "type": "boolean", "default": false }
      }
    },
    "trace_id": { "type": "string", "format": "uuid" }
  }
}